<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LUMA DETAILING — Mobile Auto Care & Driveway Wash</title>
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['"Plus Jakarta Sans"', 'sans-serif'],
                        sans: ['Inter', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        alabaster: '#FAF9F6', warmPaper: '#F3F1EC', surface: '#FFFFFF', hairline: '#E6E3DC',
                        ink: '#18181B', muted: '#52525B', subtle: '#71717A',
                        amberWarm: '#D97706', amberSoft: '#FEF3C7', sage: '#2F6F4E', sageSoft: '#EAF3EE',
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #FAF9F6; color: #18181B; overflow-x: hidden; }
        .clean-card { background-color: #FFFFFF; border: 1px solid #E6E3DC; box-shadow: 0 4px 20px -6px rgba(24,24,27,0.05); transition: transform 0.28s cubic-bezier(0.22,1,0.36,1), box-shadow 0.28s ease, border-color 0.28s ease; }
        .clean-card:hover { transform: translateY(-3px); border-color: #D4CFC4; box-shadow: 0 14px 30px -10px rgba(24,24,27,0.09); }
        .btn-primary { background-color: #18181B; color: #FFFFFF; transition: background-color 0.2s ease, transform 0.2s cubic-bezier(0.22,1,0.36,1), box-shadow 0.2s ease; }
        .btn-primary:hover { background-color: #27272A; transform: translateY(-1px); box-shadow: 0 10px 20px -8px rgba(24,24,27,0.35); }
        .btn-primary:active { transform: translateY(0px); }
        .btn-amber { background-color: #D97706; color: #FFFFFF; transition: background-color 0.2s ease, transform 0.2s cubic-bezier(0.22,1,0.36,1), box-shadow 0.2s ease; }
        .btn-amber:hover { background-color: #B45309; transform: translateY(-1px); box-shadow: 0 10px 22px -8px rgba(217,119,6,0.45); }
        .reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.65s cubic-bezier(0.22,1,0.36,1), transform 0.65s cubic-bezier(0.22,1,0.36,1); }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        .studio-backdrop { background: linear-gradient(155deg, #F6F3EC 0%, #ECE7DC 52%, #E3DDD0 100%); }
        .ba-viewport { --pos: 50%; position: relative; width: 100%; aspect-ratio: 16 / 9; background-color: #F4F2EC; border-radius: 1rem; overflow: hidden; user-select: none; -webkit-user-select: none; touch-action: pan-y; cursor: ew-resize; outline: none; }
        .ba-viewport:focus-visible { box-shadow: 0 0 0 3px rgba(217,119,6,0.45); }
        .ba-layer { position: absolute; inset: 0; width: 100%; height: 100%; background-color: #F4F2EC; }
        .ba-layer img { width: 100%; height: 100%; object-fit: cover; object-position: center; pointer-events: none; display: block; }
        .ba-before-layer { clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0); -webkit-clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0); z-index: 2; }
        .ba-after-layer { z-index: 1; }
        .ba-divider { position: absolute; top: 0; bottom: 0; left: var(--pos, 50%); width: 2px; background-color: #18181B; transform: translateX(-50%); z-index: 10; pointer-events: none; box-shadow: 0 0 0 1px rgba(255,255,255,0.8); transition: background-color 0.18s ease; }
        .ba-viewport:hover .ba-divider, .ba-viewport.dragging .ba-divider { background-color: #D97706; }
        .ba-handle { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 44px; height: 44px; border-radius: 9999px; background-color: #18181B; color: #FFFFFF; border: 3px solid #FFFFFF; box-shadow: 0 8px 20px -4px rgba(24,24,27,0.35); display: flex; align-items: center; justify-content: center; transition: transform 0.18s ease, background-color 0.18s ease; }
        .ba-viewport:hover .ba-handle, .ba-viewport.dragging .ba-handle { transform: translate(-50%,-50%) scale(1.08); background-color: #D97706; }
        .faq-answer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
        .faq-item.open .faq-answer { grid-template-rows: 1fr; }
        .faq-inner { overflow: hidden; }
        .faq-icon { transition: transform 0.25s ease; }
        .faq-item.open .faq-icon { transform: rotate(45deg); }
        .drawer-panel { transform: translateX(100%); transition: transform 0.32s cubic-bezier(0.22,1,0.36,1); }
        .drawer-open .drawer-panel { transform: translateX(0); }
    </style>
</head>
<body class="font-sans antialiased selection:bg-amberSoft selection:text-ink">

    <header class="sticky top-0 z-40 bg-alabaster/90 backdrop-blur-md border-b border-hairline">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-4 flex items-center justify-between">
            <a href="#" class="flex items-center gap-2.5 group">
                <span class="w-2.5 h-2.5 rounded-full bg-amberWarm group-hover:scale-110 transition-transform"></span>
                <span class="font-display font-bold text-lg sm:text-xl tracking-tight text-ink">LUMA <span class="font-normal text-muted">DETAILING</span></span>
            </a>
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-muted">
                <a href="#process" class="hover:text-ink transition-colors">Process</a>
                <a href="#results" class="hover:text-ink transition-colors">Results</a>
                <a href="#packages" class="hover:text-ink transition-colors">Packages</a>
                <a href="#faq" class="hover:text-ink transition-colors">FAQ</a>
            </nav>
            <div class="flex items-center gap-3">
                <button onclick="openBookingDrawer()" class="btn-primary font-display font-bold text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-full cursor-pointer">Book Now</button>
                <button id="mobile-nav-btn" aria-label="Toggle menu" class="md:hidden p-2 rounded-full border border-hairline bg-surface text-ink">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
            </div>
        </div>
        <div id="mobile-nav" class="hidden md:hidden bg-surface border-b border-hairline px-6 py-4 space-y-3 text-sm font-medium text-muted">
            <a href="#process" onclick="closeMobileNav()" class="block py-1 hover:text-ink">Process</a>
            <a href="#results" onclick="closeMobileNav()" class="block py-1 hover:text-ink">Results</a>
            <a href="#packages" onclick="closeMobileNav()" class="block py-1 hover:text-ink">Packages</a>
            <a href="#faq" onclick="closeMobileNav()" class="block py-1 hover:text-ink">FAQ</a>
        </div>
    </header>

    <main>
        <section class="pt-12 pb-20 sm:pt-18 sm:pb-24">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
                    <div class="lg:col-span-6 space-y-6">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sageSoft text-sage font-mono text-xs font-semibold tracking-wide uppercase">
                            <span class="w-1.5 h-1.5 rounded-full bg-sage"></span><span>Self-Contained Mobile Studio</span>
                        </div>
                        <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-[54px] tracking-tight leading-[1.08] text-ink">Showroom clarity, delivered to your driveway.</h1>
                        <p class="text-muted text-base sm:text-lg leading-relaxed max-w-lg">Skip waiting rooms and scratch-prone tunnel washes. We arrive at your home or office with purified spot-free water, quiet onboard power, and gentle pH-neutral hand detailing.</p>
                        <div class="pt-1 flex flex-wrap items-center gap-4">
                            <button onclick="openBookingDrawer()" class="btn-amber font-display font-bold text-sm sm:text-base px-7 py-3.5 rounded-full cursor-pointer inline-flex items-center gap-2">
                                <span>Book Your Wash</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                            </button>
                            <a href="#packages" class="font-display font-bold text-sm text-ink hover:text-amberWarm px-4 py-3 transition-colors">Explore Packages →</a>
                        </div>
                        <div class="pt-3 flex flex-wrap gap-2">
                            <span class="px-3 py-1.5 rounded-full bg-surface border border-hairline text-xs font-medium text-ink inline-flex items-center gap-1.5"><span class="text-sage font-bold">✓</span> On-Board Deionized Water</span>
                            <span class="px-3 py-1.5 rounded-full bg-surface border border-hairline text-xs font-medium text-ink inline-flex items-center gap-1.5"><span class="text-sage font-bold">✓</span> Quiet Inverter Power</span>
                            <span class="px-3 py-1.5 rounded-full bg-surface border border-hairline text-xs font-medium text-ink inline-flex items-center gap-1.5"><span class="text-sage font-bold">✓</span> pH-Neutral &amp; Paint-Safe</span>
                        </div>
                    </div>

                    <div class="lg:col-span-6">
                        <div class="clean-card rounded-3xl p-3.5 sm:p-4">
                            <div class="studio-backdrop rounded-2xl overflow-hidden relative aspect-[4/3] border border-hairline/80">
                                <svg viewBox="0 0 800 600" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="heroWarmBg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F6F3EC"/><stop offset="55%" stop-color="#ECE7DC"/><stop offset="100%" stop-color="#DFD8CA"/></linearGradient>
                                        <radialGradient id="heroSunGlow" cx="72%" cy="24%" r="55%"><stop offset="0%" stop-color="#FFFDF8" stop-opacity="0.95"/><stop offset="100%" stop-color="#ECE7DC" stop-opacity="0"/></radialGradient>
                                        <linearGradient id="heroCarCoat" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3E444D"/><stop offset="45%" stop-color="#252930"/><stop offset="100%" stop-color="#171A1F"/></linearGradient>
                                    </defs>
                                    <rect width="800" height="600" fill="url(#heroWarmBg)"/>
                                    <rect width="800" height="600" fill="url(#heroSunGlow)"/>
                                    <ellipse cx="400" cy="462" rx="310" ry="24" fill="#18181B" opacity="0.16"/>
                                    <path d="M125 395 C132 355 170 335 235 322 L315 262 C365 235 465 235 535 268 L628 320 C678 332 702 356 704 396 L690 426 L138 426 Z" fill="url(#heroCarCoat)"/>
                                    <path d="M258 318 L324 268 C372 246 456 246 516 274 L592 318 Z" fill="#CBD5E1" opacity="0.55"/>
                                    <path d="M180 356 C310 342 495 342 645 362" stroke="#FFFFFF" stroke-opacity="0.32" stroke-width="3" fill="none"/>
                                    <circle cx="240" cy="422" r="46" fill="#18181B"/><circle cx="240" cy="422" r="30" fill="#A1A1AA"/><circle cx="240" cy="422" r="10" fill="#27272A"/>
                                    <circle cx="585" cy="422" r="46" fill="#18181B"/><circle cx="585" cy="422" r="30" fill="#A1A1AA"/><circle cx="585" cy="422" r="10" fill="#27272A"/>
                                </svg>
                                <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1400&q=85" alt="Freshly detailed dark metallic sports sedan parked in natural daylight" onerror="this.style.display='none'" class="relative z-10 w-full h-full object-cover object-center"/>
                                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/55 via-black/20 to-transparent z-20 pointer-events-none"></div>
                                <div class="absolute bottom-3.5 left-3.5 right-3.5 sm:right-auto z-20 inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface/95 backdrop-blur-md border border-hairline shadow-sm">
                                    <span class="w-2 h-2 rounded-full bg-sage shrink-0"></span>
                                    <span class="font-mono text-[11px] sm:text-xs font-medium text-ink">0-TDS Spot-Free Rinse • Brought to Your Curb</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="process" class="py-16 sm:py-20 border-y border-hairline bg-surface">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-xl mb-12 reveal">
                    <span class="font-mono text-xs uppercase tracking-widest text-amberWarm font-semibold">How It Works</span>
                    <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-ink mt-1.5">Effortless care from curb to keys.</h2>
                </div>
                <div class="grid md:grid-cols-3 gap-7">
                    <div class="p-6 rounded-2xl bg-alabaster border border-hairline reveal">
                        <span class="font-mono text-xs font-semibold text-amberWarm bg-amberSoft px-2.5 py-1 rounded-md">01</span>
                        <h3 class="font-display font-bold text-lg text-ink mt-4">Pick Your Package</h3>
                        <p class="text-muted text-sm mt-2 leading-relaxed">Choose the level of exterior or full interior care your vehicle needs and reserve a convenient arrival window.</p>
                    </div>
                    <div class="p-6 rounded-2xl bg-alabaster border border-hairline reveal">
                        <span class="font-mono text-xs font-semibold text-sage bg-sageSoft px-2.5 py-1 rounded-md">02</span>
                        <h3 class="font-display font-bold text-lg text-ink mt-4">We Bring Water &amp; Power</h3>
                        <p class="text-muted text-sm mt-2 leading-relaxed">Our mobile van arrives at your driveway or office with its own purified water tank and whisper-quiet inverter power.</p>
                    </div>
                    <div class="p-6 rounded-2xl bg-alabaster border border-hairline reveal">
                        <span class="font-mono text-xs font-semibold text-ink bg-warmPaper px-2.5 py-1 rounded-md border border-hairline">03</span>
                        <h3 class="font-display font-bold text-lg text-ink mt-4">Drive Away Spotless</h3>
                        <p class="text-muted text-sm mt-2 leading-relaxed">Walk around your mirror-gloss finish and fresh cabin when we finish. Pay only once you are completely satisfied.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="results" class="py-20 sm:py-24 border-b border-hairline bg-warmPaper/50">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12 reveal">
                    <div>
                        <span class="font-mono text-xs uppercase tracking-widest text-amberWarm font-semibold">Interactive Driveway Inspection</span>
                        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-ink mt-1.5">Before &amp; After Results</h2>
                    </div>
                    <p class="text-muted text-sm sm:text-base max-w-md">Drag the divider line left and right across the same BMW M3 sedan to inspect bug &amp; mud extraction, wheel barrel decontamination, and mirror ceramic gloss.</p>
                </div>

                <div class="space-y-8">
                    <!-- Comparison 1: Front -->
                    <article class="clean-card rounded-3xl p-4 sm:p-6 reveal">
                        <div id="ba-front" class="ba-viewport border border-hairline" data-ba-slider tabindex="0" role="slider" aria-label="Front view before and after comparison slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" style="--pos: 50%;">
                            <div class="ba-layer ba-after-layer" data-ba-after>
                                <img src="data:image/jpeg;base64," alt="Front view of charcoal BMW M3 sedan after mobile wash" loading="eager"/>
                            </div>
                            <div class="ba-layer ba-before-layer" data-ba-before>
                                <img src="data:image/jpeg;base64," alt="Front view of charcoal BMW M3 sedan covered in mud and grime before wash" loading="eager"/>
                            </div>
                            <span class="absolute top-3.5 left-3.5 z-10 px-3 py-1 rounded-full bg-ink/85 text-white font-mono text-[11px] font-semibold tracking-wider uppercase pointer-events-none">Before</span>
                            <span class="absolute top-3.5 right-3.5 z-10 px-3 py-1 rounded-full bg-sage text-white font-mono text-[11px] font-semibold tracking-wider uppercase shadow-xs pointer-events-none">After</span>
                            <div class="hidden sm:flex absolute bottom-3.5 left-1/2 -translate-x-1/2 z-10 items-center gap-1.5 px-3 py-1 rounded-full bg-surface/90 backdrop-blur-xs border border-hairline font-mono text-[11px] text-muted pointer-events-none"><span>← Drag line or use arrow keys to inspect →</span></div>
                            <div class="ba-divider"><div class="ba-handle" aria-hidden="true"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 9l-3 3 3 3M16 9l3 3-3 3"/></svg></div></div>
                        </div>
                        <div class="pt-5 px-1 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <div class="flex items-center gap-2.5">
                                    <span class="font-mono text-xs text-amberWarm font-semibold">01 / FRONT VIEW</span>
                                    <span class="text-hairline">•</span>
                                    <span class="font-mono text-xs text-muted">Bumper, Kidney Grilles &amp; Headlight Clarity</span>
                                </div>
                                <h3 class="font-display font-bold text-xl text-ink mt-1">Direct Front View — Bug, Grime &amp; Oxidation Removal</h3>
                            </div>
                            <div class="flex items-center gap-1.5 self-start sm:self-center">
                                <button type="button" onclick="setSliderPreset(this, 88)" class="px-3 py-1.5 rounded-full border border-hairline bg-alabaster hover:border-ink font-mono text-[11px] text-ink transition-colors cursor-pointer">Show Before</button>
                                <button type="button" onclick="setSliderPreset(this, 50)" class="px-3 py-1.5 rounded-full border border-hairline bg-alabaster hover:border-ink font-mono text-[11px] text-ink transition-colors cursor-pointer">50 / 50</button>
                                <button type="button" onclick="setSliderPreset(this, 12)" class="px-3 py-1.5 rounded-full border border-hairline bg-alabaster hover:border-ink font-mono text-[11px] text-ink transition-colors cursor-pointer">Show After</button>
                            </div>
                        </div>
                    </article>

                    <!-- Comparison 2: Side -->
                    <article class="clean-card rounded-3xl p-4 sm:p-6 reveal">
                        <div id="ba-side" class="ba-viewport border border-hairline" data-ba-slider tabindex="0" role="slider" aria-label="Side profile before and after comparison slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" style="--pos: 50%;">
                            <div class="ba-layer ba-after-layer" data-ba-after>
                                <img src="data:image/jpeg;base64," alt="Side profile of charcoal BMW M3 sedan with spotless paint and clean alloy wheels" loading="eager"/>
                            </div>
                            <div class="ba-layer ba-before-layer" data-ba-before>
                                <img src="data:image/jpeg;base64," alt="Side profile of charcoal BMW M3 sedan with mud along the doors and rocker panels" loading="eager"/>
                            </div>
                            <span class="absolute top-3.5 left-3.5 z-10 px-3 py-1 rounded-full bg-ink/85 text-white font-mono text-[11px] font-semibold tracking-wider uppercase pointer-events-none">Before</span>
                            <span class="absolute top-3.5 right-3.5 z-10 px-3 py-1 rounded-full bg-sage text-white font-mono text-[11px] font-semibold tracking-wider uppercase shadow-xs pointer-events-none">After</span>
                            <div class="hidden sm:flex absolute bottom-3.5 left-1/2 -translate-x-1/2 z-10 items-center gap-1.5 px-3 py-1 rounded-full bg-surface/90 backdrop-blur-xs border border-hairline font-mono text-[11px] text-muted pointer-events-none"><span>← Drag line or use arrow keys to inspect →</span></div>
                            <div class="ba-divider"><div class="ba-handle" aria-hidden="true"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 9l-3 3 3 3M16 9l3 3-3 3"/></svg></div></div>
                        </div>
                        <div class="pt-5 px-1 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <div class="flex items-center gap-2.5">
                                    <span class="font-mono text-xs text-sage font-semibold">02 / SIDE PROFILE</span>
                                    <span class="text-hairline">•</span>
                                    <span class="font-mono text-xs text-muted">Door Panels, Alloy Barrels &amp; Tires</span>
                                </div>
                                <h3 class="font-display font-bold text-xl text-ink mt-1">Direct Side Profile — Lower Rocker Mud &amp; Wheel Decontamination</h3>
                            </div>
                            <div class="flex items-center gap-1.5 self-start sm:self-center">
                                <button type="button" onclick="setSliderPreset(this, 88)" class="px-3 py-1.5 rounded-full border border-hairline bg-alabaster hover:border-ink font-mono text-[11px] text-ink transition-colors cursor-pointer">Show Before</button>
                                <button type="button" onclick="setSliderPreset(this, 50)" class="px-3 py-1.5 rounded-full border border-hairline bg-alabaster hover:border-ink font-mono text-[11px] text-ink transition-colors cursor-pointer">50 / 50</button>
                                <button type="button" onclick="setSliderPreset(this, 12)" class="px-3 py-1.5 rounded-full border border-hairline bg-alabaster hover:border-ink font-mono text-[11px] text-ink transition-colors cursor-pointer">Show After</button>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section id="packages" class="py-20 sm:py-24">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 reveal">
                    <div>
                        <span class="font-mono text-xs uppercase tracking-widest text-amberWarm font-semibold">Transparent Rates</span>
                        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-ink mt-1.5">Detailing Packages</h2>
                        <p class="text-muted text-sm sm:text-base mt-2 max-w-md">Toggle your vehicle size below. All packages include mobile travel to your driveway.</p>
                    </div>
                    <div class="inline-flex p-1 rounded-full bg-warmPaper border border-hairline self-start md:self-auto">
                        <button id="toggle-sedan" onclick="setVehicleSize('sedan')" class="px-5 py-2 rounded-full font-display font-bold text-xs sm:text-sm transition-all bg-ink text-white shadow-sm cursor-pointer">Sedan / Coupe</button>
                        <button id="toggle-suv" onclick="setVehicleSize('suv')" class="px-5 py-2 rounded-full font-display font-bold text-xs sm:text-sm transition-all text-muted hover:text-ink cursor-pointer">SUV / Truck</button>
                    </div>
                </div>

                <div class="grid lg:grid-cols-3 gap-7 items-stretch">
                    <div class="clean-card rounded-3xl p-7 sm:p-8 flex flex-col justify-between reveal">
                        <div>
