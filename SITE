    <script>
        let vehicleSize = 'sedan';
        let selectedWindow = '11:00 AM';
        const packagePrices = {
            'Express Exterior': { sedan: 65, suv: 80 },
            'Signature Full Detail': { sedan: 145, suv: 175 },
            'Ceramic Gloss & Interior': { sedan: 240, suv: 285 }
        };
        function animateNumber(el, target) {
            const start = parseInt(el.textContent, 10) || target;
            const duration = 240, startTime = performance.now();
            function step(now) {
                const progress = Math.min((now - startTime) / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.round(start + (target - start) * ease);
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }
        function setVehicleSize(size) {
            vehicleSize = size;
            const sedanBtn = document.getElementById('toggle-sedan'), suvBtn = document.getElementById('toggle-suv');
            const on = 'px-5 py-2 rounded-full font-display font-bold text-xs sm:text-sm transition-all bg-ink text-white shadow-sm cursor-pointer';
            const off = 'px-5 py-2 rounded-full font-display font-bold text-xs sm:text-sm transition-all text-muted hover:text-ink cursor-pointer';
            sedanBtn.className = size === 'sedan' ? on : off;
            suvBtn.className = size === 'suv' ? on : off;
            animateNumber(document.getElementById('price-1'), packagePrices['Express Exterior'][size]);
            animateNumber(document.getElementById('price-2'), packagePrices['Signature Full Detail'][size]);
            animateNumber(document.getElementById('price-3'), packagePrices['Ceramic Gloss & Interior'][size]);
        }
        function openBookingDrawer(pkgName) {
            const drawer = document.getElementById('booking-drawer');
            document.getElementById('drawer-form').classList.remove('hidden');
            document.getElementById('drawer-footer').classList.remove('hidden');
            document.getElementById('drawer-confirmation').classList.add('hidden');
            document.getElementById('drawer-error').classList.add('hidden');
            setDrawerVehicle(vehicleSize);
            if (pkgName) document.getElementById('drawer-package').value = pkgName;
            const dateInput = document.getElementById('drawer-date');
            if (!dateInput.value) {
                const tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                dateInput.value = tomorrow.toISOString().split('T')[0];
            }
            updateDrawerTotal();
            drawer.classList.remove('hidden');
            requestAnimationFrame(() => drawer.classList.add('drawer-open'));
            document.body.style.overflow = 'hidden';
        }
        function closeBookingDrawer() {
            const drawer = document.getElementById('booking-drawer');
            drawer.classList.remove('drawer-open');
            setTimeout(() => { drawer.classList.add('hidden'); document.body.style.overflow = ''; }, 280);
        }
        function setDrawerVehicle(size) {
            vehicleSize = size;
            const dSedan = document.getElementById('drawer-size-sedan'), dSuv = document.getElementById('drawer-size-suv');
            const on = 'py-2 rounded-full font-display font-bold text-xs transition-all bg-ink text-white cursor-pointer';
            const off = 'py-2 rounded-full font-display font-bold text-xs transition-all text-muted hover:text-ink cursor-pointer';
            dSedan.className = size === 'sedan' ? on : off;
            dSuv.className = size === 'suv' ? on : off;
            updateDrawerTotal();
        }
        function pickTimeWindow(btn, timeLabel) {
            selectedWindow = timeLabel;
            document.querySelectorAll('.time-pill').forEach(pill => {
                pill.className = 'time-pill py-2 px-3 rounded-xl font-mono text-xs border border-hairline bg-alabaster text-muted hover:text-ink cursor-pointer';
            });
            btn.className = 'time-pill py-2 px-3 rounded-xl font-mono text-xs border border-ink bg-ink text-white cursor-pointer';
        }
        function updateDrawerTotal() {
            const pkg = document.getElementById('drawer-package').value;
            const total = packagePrices[pkg][vehicleSize];
            document.getElementById('drawer-total').textContent = total;
            return { pkg, total };
        }
        function confirmBooking() {
            const vehicleModel = document.getElementById('drawer-vehicle-model').value.trim();
            const address = document.getElementById('drawer-address').value.trim();
            const name = document.getElementById('drawer-name').value.trim();
            const phone = document.getElementById('drawer-phone').value.trim();
            const dateVal = document.getElementById('drawer-date').value;
            if (!address || !name || !phone) { document.getElementById('drawer-error').classList.remove('hidden'); return; }
            const { pkg, total } = updateDrawerTotal();
            const sizeLabel = vehicleSize === 'sedan' ? 'Sedan / Coupe' : 'SUV / Truck';
            document.getElementById('conf-ref').textContent = `#LM-${Math.floor(100 + Math.random() * 899)}`;
            document.getElementById('conf-message').textContent = `Thanks, ${name}. We’ll send a text to ${phone} 20 minutes before arriving at your driveway.`;
            document.getElementById('conf-vehicle').textContent = vehicleModel ? `${vehicleModel} (${sizeLabel})` : sizeLabel;
            document.getElementById('conf-package').textContent = pkg;
            document.getElementById('conf-time').textContent = `${dateVal} • ${selectedWindow}`;
            document.getElementById('conf-address').textContent = address;
            document.getElementById('conf-total').textContent = `$${total}`;
            document.getElementById('drawer-form').classList.add('hidden');
            document.getElementById('drawer-footer').classList.add('hidden');
            document.getElementById('drawer-confirmation').classList.remove('hidden');
        }
        function toggleFaq(button) {
            const item = button.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }
        const mobileNavBtn = document.getElementById('mobile-nav-btn');
        const mobileNav = document.getElementById('mobile-nav');
        mobileNavBtn.addEventListener('click', () => mobileNav.classList.toggle('hidden'));
        function closeMobileNav() { mobileNav.classList.add('hidden'); }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); } });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        function setSliderPercent(slider, percent) {
            const clamped = Math.max(2, Math.min(98, percent));
            slider.style.setProperty('--pos', `${clamped.toFixed(2)}%`);
            slider.setAttribute('aria-valuenow', Math.round(clamped));
        }
        function updateSliderPosition(slider, clientX) {
            const rect = slider.getBoundingClientRect();
            setSliderPercent(slider, ((clientX - rect.left) / rect.width) * 100);
        }
        function setSliderPreset(btn, targetPercent) {
            const card = btn.closest('article');
            const slider = card ? card.querySelector('[data-ba-slider]') : null;
            if (!slider) return;
            const current = parseFloat(slider.style.getPropertyValue('--pos')) || 50;
            const startTime = performance.now(), duration = 260;
            function animateSlide(now) {
                const progress = Math.min((now - startTime) / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 3);
                setSliderPercent(slider, current + (targetPercent - current) * ease);
                if (progress < 1) requestAnimationFrame(animateSlide);
            }
            requestAnimationFrame(animateSlide);
        }
        document.querySelectorAll('[data-ba-slider]').forEach(slider => {
            let isDragging = false;
            slider.addEventListener('pointerdown', (e) => {
                isDragging = true;
                slider.classList.add('dragging');
                if (slider.setPointerCapture && e.pointerId !== undefined) slider.setPointerCapture(e.pointerId);
                updateSliderPosition(slider, e.clientX);
            });
            slider.addEventListener('pointermove', (e) => { if (isDragging) updateSliderPosition(slider, e.clientX); });
            const end = (e) => {
                if (!isDragging) return;
                isDragging = false;
                slider.classList.remove('dragging');
                if (slider.releasePointerCapture && e.pointerId !== undefined) { try { slider.releasePointerCapture(e.pointerId); } catch (_) {} }
            };
            slider.addEventListener('pointerup', end);
            slider.addEventListener('pointercancel', end);
            slider.addEventListener('keydown', (e) => {
                const current = parseFloat(slider.style.getPropertyValue('--pos')) || 50;
                if (e.key === 'ArrowLeft') { e.preventDefault(); setSliderPercent(slider, current - 4); }
                else if (e.key === 'ArrowRight') { e.preventDefault(); setSliderPercent(slider, current + 4); }
            });
        });
    </script>
</body>
</html>
